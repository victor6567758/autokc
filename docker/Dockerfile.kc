FROM apache/kafka:3.7.0

COPY --from=zv-debezium-connector-postgres:dev /connectors/ /opt/connect-plugins/postgres/
COPY --from=zv-debezium-connector-jdbc:dev /connectors/ /opt/connect-plugins/jdbc/
# agent from the jdbc packager image; --chmod: image runs as non-root appuser
COPY --chmod=0644 --from=zv-debezium-connector-jdbc:dev /jmx-exporter/jmx_prometheus_javaagent.jar /opt/jmx_prometheus_javaagent.jar

EXPOSE 8083 5557

