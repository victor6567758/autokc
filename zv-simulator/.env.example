# zv-simulator endpoint overrides.
# Copy to the autokc repo root as .env and adjust - .env is gitignored,
# this template is not.
# Precedence: exported env var > .env > built-in defaults in config.py.

# Control-plane endpoints (host view of the `make up` stack)
ZV_SIM_CONNECT_URL=http://localhost:8083     # kafka-connect REST API
ZV_SIM_PROM_URL=http://localhost:9090        # Prometheus
ZV_SIM_LOKI_URL=http://localhost:3100        # Loki
ZV_SIM_TOXIPROXY_URL=http://localhost:8474   # Toxiproxy control API

# --- rarely needed, uncomment to override -----------------------------------
# ZV_SIM_COMPOSE_PROJECT=development
# ZV_SIM_PG_SOURCE_HOST=localhost
# ZV_SIM_PG_SOURCE_PORT=5432
# ZV_SIM_PG_SINK_HOST=localhost
# ZV_SIM_PG_SINK_PORT=5433
# ZV_SIM_SOURCE_CONNECTOR=inventory-source
# ZV_SIM_SINK_CONNECTOR=customers-sink
# ZV_SIM_SLOT_NAME=dbz_customers_slot
# ZV_SIM_PUBLICATION=dbz_publication
