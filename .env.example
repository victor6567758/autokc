# zv-simulator endpoint overrides.
# Copy this file to .env (next to it, repo root) and adjust - .env is
# gitignored, this template is not.
# Precedence: exported env var > .env > built-in defaults in zv-simulator/config.py.

# Control-plane endpoints (host view of the `make up` stack)
ZV_SIM_CONNECT_URL=http://localhost:8083     # kafka-connect REST API
ZV_SIM_PROM_URL=http://localhost:9090        # Prometheus
ZV_SIM_LOKI_URL=http://localhost:3100        # Loki
ZV_SIM_TOXIPROXY_URL=http://localhost:8474   # Toxiproxy control API

# Toxiproxy fixture (network-cut-source / network-latency-source): how the
# simulator reaches / guarantees the proxy on the stack network
ZV_SIM_TOXIPROXY_HOST=toxiproxy                       # in-network hostname the connector is repointed to
ZV_SIM_TOXIPROXY_LISTEN_PORT=15432                    # proxy's listen port for postgres traffic
ZV_SIM_TOXIPROXY_IMAGE=ghcr.io/shopify/toxiproxy:2.9.0  # sidecar image (override-file service pins its own copy)
ZV_SIM_TOXIPROXY_SIDECAR_NAME=zv-sim-toxiproxy        # simulator-owned sidecar container name
ZV_SIM_TOXIPROXY_SIDECAR_LABEL=zv-simulator.managed   # ownership marker ("ours to clean up")
ZV_SIM_TOXIPROXY_COMPOSE_SERVICE=toxiproxy            # service name in zv-simulator/docker-compose.override.yml

# --- rarely needed, uncomment to override -----------------------------------
# ZV_SIM_QUIET=1                              # silence live INFO log lines (CI)
# ZV_SIM_COMPOSE_PROJECT=development
# ZV_SIM_PG_SOURCE_HOST=localhost
# ZV_SIM_PG_SOURCE_PORT=5432
# ZV_SIM_PG_SINK_HOST=localhost
# ZV_SIM_PG_SINK_PORT=5433
# ZV_SIM_SOURCE_CONNECTOR=inventory-source
# ZV_SIM_SINK_CONNECTOR=customers-sink
# ZV_SIM_SLOT_NAME=dbz_customers_slot
# ZV_SIM_PUBLICATION=dbz_publication
# ZV_SIM_WAL_BLOAT_TABLE=zv_sim_wal_bloat     # scratch table for slot-wal-retention-high
